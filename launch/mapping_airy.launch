<launch>
  <arg name="start_driver" default="true" />
  <arg name="rviz" default="false" />
  <arg name="driver_config" default="$(find rslidar_sdk)/config/config_airy.yaml" />

  <include if="$(arg start_driver)" file="$(find rslidar_sdk)/launch/start_airy.launch">
    <arg name="rviz" value="false" />
    <arg name="config_path" value="$(arg driver_config)" />
  </include>

  <rosparam command="load" file="$(find fast_lio)/config/airy.yaml" />
  <param name="feature_extract_enable" type="bool" value="false" />
  <param name="point_filter_num" type="int" value="3" />
  <param name="max_iteration" type="int" value="3" />
  <param name="filter_size_surf" type="double" value="0.3" />
  <param name="filter_size_map" type="double" value="0.4" />
  <param name="cube_side_length" type="double" value="500" />
  <param name="runtime_pos_log_enable" type="bool" value="false" />

  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" required="true" />

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
  </group>
</launch>
