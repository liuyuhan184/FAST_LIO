# Airy + FAST-LIO2 + PX4/MAVROS 本机配置模板
#
# 复制后再填写：
#   cp shfile/airy_px4.env.example shfile/airy_px4.env
# shfile/airy_px4.env 已被 .gitignore 忽略，避免把某一架飞机的标定误用于其他飞机。

# MAVROS/PX4 串口。当前 Orin + 飞控实测链路为 TELEM1 / ttyTHS0 921600。
UAV_NAME=liu
FCU_URL=/dev/ttyTHS0:921600

# 默认不把 MAVLink 转发给地面站，避免使用系统 px4.launch 中写死的旧 IP。
# 需要 QGroundControl 时再填写明确地址，例如 udp://:14550@192.168.31.44:14550。
GCS_URL=
MAV_SYS_ID=1
MAV_COMP_ID=1
EXPECTED_PX4_MAJOR=1
EXPECTED_PX4_MINOR=13

START_ROSCORE=1
START_MAVROS=1
START_FASTLIO=1
START_BRIDGE=1
START_MONITOR=1

# 三个开关必须按顺序、在拆桨状态下完成验证后才允许改为 1。
# PUBLISH_VISION=1 只请求发布；启动器还会只读检查 EKF2_AID_MASK 等硬门控。
PUBLISH_VISION=0
MOUNT_CONFIRMED=0
DIRECTION_TEST_CONFIRMED=0
# 仅在用户明确接受近似安装方向、用于拆桨 Position 接受性验证时才可设为 1。
# 它允许普通启动发送位姿，但不会把 DIRECTION_TEST_CONFIRMED 伪装成 1，监控仍会告警。
ALLOW_APPROXIMATE_DIRECTION_PUBLISH=0

# 定义：该四元数 [x,y,z,w] 将“Airy 内部 IMU 坐标系 I”的向量旋转到
# “飞机 ROS base_link/FLU 坐标系 B”（x 前、y 左、z 上）。
# 下面的单位四元数只是占位值，不是本机标定结果。
# 2026-08-28 未解锁实测：使用该占位值时，两颗 IMU 的重力方向相差 178.86°，
# 几乎相反，因此本机明确不能使用单位四元数。重力只能约束横滚/俯仰，不能确定
# 航向；不要仅凭“约 180°”猜测绕 X 轴还是 Y 轴，必须按实际安装方向标定并做
# 拆桨的前/左/上平移与转向符号测试。
SENSOR_TO_BODY_Q_X=0.0
SENSOR_TO_BODY_Q_Y=0.0
SENSOR_TO_BODY_Q_Z=0.0
SENSOR_TO_BODY_Q_W=1.0

# Airy 内部 IMU 原点相对飞机控制/重心原点的位置，单位 m，表达在 base_link/FLU。
# 桥接器用它把传感器轨迹换算到飞机原点。PX4 的 EKF2_EV_POS_X/Y/Z 必须保持 0，
# 否则会重复做一次杆臂补偿。
SENSOR_POSITION_IN_BODY_X=0.0
SENSOR_POSITION_IN_BODY_Y=0.0
SENSOR_POSITION_IN_BODY_Z=0.0

# PX4 v1.13 的 EKF2_AID_MASK=24 同时开启视觉位置（8）和视觉 yaw（16）。
# FAST-LIO 航向、安装旋转和拆桨转向符号尚未独立验证时必须保持 0；否则启动器
# 会把包含 yaw 融合的配置视为未获准并阻止整路视觉发布。
ALLOW_VISION_YAW_FUSION=0

# 当前 FAST-LIO 实测约 10 Hz；PX4 外部视觉飞行验收建议至少 30 Hz。
# 启动器不会伪造时间戳或重复旧位姿来凑频率。
MIN_FASTLIO_RATE_HZ=8.0
FLIGHT_MIN_POSE_RATE_HZ=30.0
# MAVLink 下行本地位姿只做持续性诊断，不要求与外部视觉同频。
MIN_LOCAL_POSE_RATE_HZ=2.0
ALIGN_STABLE_SECONDS=5.0
MAX_SOURCE_AGE_S=0.5
# 相邻 /Odometry header 时间戳的真实缺帧阈值，连续使用保持 0.30。
# 若超过阈值，应优先检查 rmem_max、UDP 丢包和 FAST-LIO，而不是掩盖。
MAX_SOURCE_GAP_S=0.30
# ROS 回调/进程整体停顿阈值；与真实 header 时间戳缺帧分开判断。单次 0.339 秒
# callback receipt 空档不会单独锁存，达到 0.50 秒仍会停发。
MAX_RECEIPT_STALL_S=0.50
MAX_POSITION_JUMP_M=1.0
MAX_ORIENTATION_JUMP_DEG=45.0
MAX_GRAVITY_MISMATCH_DEG=10.0

# 可选：运行日志默认写入项目 runtime/airy_px4/，该目录不会提交到 Git。
# SESSION_ROOT=/home/liu/study/FAST_LIO/runtime/airy_px4
